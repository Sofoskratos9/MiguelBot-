# Clave API de DeepSeek para el evaluador diagnóstico interactivo (solo en servidor: .env.local o Vercel, nunca en el navegador)
DEEPSEEK_API_KEY=

# Modelo opcional de DeepSeek (por defecto: deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# --- Configuración del servidor para Pagos con Stripe y Descarga Segura (Vercel Environment Variables) ---
# Secreto HMAC para firmar tokens de descarga tras verificar un pago real (mínimo 32 caracteres aleatorios)
# DOWNLOAD_TOKEN_SECRET=

# Precios opcionales en MXN para los 3 packs descargables (valores por defecto: 99, 149, 79)
# PRICE_NEURO_KIT_MXN=99
# PRICE_REACTIVOS_PACK_MXN=149
# PRICE_NSDR_PROTOCOL_MXN=79

# Stripe (Tarjeta, Apple Pay / Google Pay / Link - usa claves sk_live_... o sk_test_... solo en servidor)
# STRIPE_SECRET_KEY=

# Códigos de acceso opcionales (separados por coma) para alumnos presenciales o pruebas
# KIT_ACCESS_CODES=

# Opcional: clave de Tavily para consultar en vivo fuentes oficiales ceneval.edu.mx / uaa.mx desde el chat y GitHub Actions
# TAVILY_API_KEY=
