# Clave API para el evaluador diagnóstico interactivo (nunca subas .env.local a GitHub)
GEMINI_API_KEY=

# Modelo opcional (por defecto: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# --- Configuración del servidor para Pagos y Descarga Segura (Vercel Environment Variables) ---
# Secreto HMAC para firmar tokens de descarga tras verificar un pago real (mínimo 32 caracteres aleatorios)
# DOWNLOAD_TOKEN_SECRET=

# Precio en MXN y nombre del cuadernillo completo
# KIT_PRICE_MXN=299
# KIT_PRODUCT_NAME=Kit Estratégico EXANI-II UAA 2026 (PDF Completo)

# Stripe (usa claves reales sk_live_... o de prueba sk_test_... solo en servidor)
# STRIPE_SECRET_KEY=

# Mercado Pago (Access Token solo en servidor)
# MERCADOPAGO_ACCESS_TOKEN=

# Códigos de acceso opcionales (separados por coma) para alumnos que pagaron por transferencia/mentoria
# KIT_ACCESS_CODES=
